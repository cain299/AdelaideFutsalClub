---
import { Image } from 'astro:assets';
import { getPosts } from '../data/instagram';
import { socials } from '../data/site';
import SocialIcon from './SocialIcon.astro';

const posts = await getPosts(5);
const ig = socials.find((s) => s.name === 'Instagram')!;
const fmt = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
---

<section class="section feed" aria-labelledby="feed-title">
  <div class="wrap">
    <div class="head">
      <div>
        <h2 id="feed-title">Latest from the Lions</h2>
        <p class="muted">Results, weekly honours and stories from the club, straight from our Instagram.</p>
      </div>
      <a class="btn btn--ghost" href={ig.url} target="_blank" rel="noopener">
        <SocialIcon name="Instagram" size={20} /> Follow {ig.handle}
      </a>
    </div>

    <ul class="grid">
      {posts.map((p, i) => {
        const feature = i === 0;
        return (
          <li class={feature ? 'feature' : ''}>
            <a href={p.url} target="_blank" rel="noopener" class="post">
              {typeof p.image === 'string' ? (
                <img src={p.image} alt={p.alt} loading="lazy" decoding="async" />
              ) : (
                <Image
                  src={p.image}
                  alt={p.alt}
                  widths={feature ? [640, 960, 1280] : [400, 640, 800]}
                  sizes={feature ? '(max-width: 48rem) 100vw, 50vw' : '(max-width: 48rem) 50vw, 25vw'}
                  quality={82}
                />
              )}
              <span class="meta">
                <span class="tag">{p.tag}</span>
                <span class="caption">{p.caption}</span>
                <time datetime={p.date}>{fmt.format(new Date(p.date))}</time>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: 2rem;
  }
  .head h2 { margin-bottom: 0.25em; }
  .head p { margin: 0; }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 1fr;
    gap: clamp(0.5rem, 1.2vw, 0.875rem);
  }
  .feature { grid-column: span 2; grid-row: span 2; }

  .post {
    position: relative;
    display: block;
    height: 100%;
    min-height: 15rem;
    overflow: hidden;
    background: var(--court);
    text-decoration: none;
    color: var(--chalk);
  }
  .post img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    transition: transform 0.5s ease;
  }
  .post:hover img, .post:focus-visible img { transform: scale(1.04); }
  .post:hover { color: var(--chalk); }

  .meta {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    justify-items: start;
    gap: 0.4rem;
    padding: 3.5rem 1rem 1rem;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.55) 30%, rgb(0 0 0 / 0.92));
  }
  .tag {
    padding: 0.2rem 0.55rem;
    background: var(--orange);
    color: var(--night);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.2;
  }
  .caption {
    font-size: 0.9rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  time { color: var(--muted-dark); font-size: var(--step--1); }

  .feature .meta { padding: 6rem clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2rem); gap: 0.6rem; }
  .feature .tag { font-size: 1.1rem; }
  .feature .caption {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    text-transform: uppercase;
    -webkit-line-clamp: 3;
    max-width: 22ch;
  }

  @media (max-width: 48rem) {
    .grid { grid-template-columns: 1fr 1fr; grid-auto-rows: auto; }
    .feature { grid-column: 1 / -1; grid-row: auto; }
    .feature .post { aspect-ratio: 4 / 5; }
    .post { aspect-ratio: 1; min-height: 0; }
    .grid li:not(.feature) .caption { display: none; }
    .meta { padding: 2.5rem 0.75rem 0.75rem; }
  }
</style>
