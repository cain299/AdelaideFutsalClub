---
import { Image } from 'astro:assets';
import crest from '../assets/crest.jpg';
import SocialIcon from './SocialIcon.astro';
import { nav, site, socials } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="club">
      <Image src={crest} alt="" width={72} height={72} class="crest" />
      <p class="name">{site.name}</p>
      <p class="muted">Est. {site.founded}. Adelaide, South Australia.<br />Competing in Futsal SA competitions.</p>
    </div>

    <div>
      <h2 class="label">Club</h2>
      <ul class="links">
        <li><a href="/">Home</a></li>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="label">Contact</h2>
      <ul class="links">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.contacts.map((c) => (
          <li>{c.name}: <a href={`tel:${c.phone.replace(/\s/g, '')}`}>{c.phone}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="label">Follow the Lions</h2>
      <ul class="social">
        {socials.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener">
              <SocialIcon name={s.name} />
              <span>{s.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="wrap base">
    <p>© {year} {site.legalName}</p>
    <a href={site.registerUrl} target="_blank" rel="noopener">{site.registerLabel}</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 4px solid var(--orange);
    background: var(--night);
    padding-top: clamp(3rem, 8vw, 5rem);
    font-size: 0.95rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 2.5rem;
  }
  .crest { border-radius: 50%; margin-bottom: 1rem; }
  .name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.6rem;
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .label {
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    color: var(--orange);
    margin-bottom: 1rem;
  }
  .links, .social { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .links a { text-decoration: none; }
  .links a:hover { text-decoration: underline; }
  .social a { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--court-line);
    color: var(--muted-dark);
    font-size: var(--step--1);
  }
  .base p { margin: 0; }
  @media (max-width: 52rem) {
    .grid { grid-template-columns: 1fr 1fr; }
    .club { grid-column: 1 / -1; }
  }
  @media (max-width: 30rem) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
