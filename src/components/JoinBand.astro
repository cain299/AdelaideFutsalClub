---
import { site } from '../data/site';
---

<section class="join" aria-labelledby="join-title">
  <div class="wrap inner">
    <div>
      <h2 id="join-title">Play for the Lions</h2>
      <p>Boys and girls from Under 6, through to our senior side. No experience needed for our youngest groups, just runners and a water bottle.</p>
    </div>
    <div class="btn-row">
      <a class="btn" href={site.registerUrl} target="_blank" rel="noopener">{site.registerLabel}</a>
      <a class="btn btn--ghost" href="/contact/">Ask a question</a>
    </div>
  </div>
</section>

<style>
  .join {
    background: var(--orange);
    color: var(--night);
    padding-block: clamp(3rem, 7vw, 4.5rem);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }
  h2 { font-size: clamp(3rem, 8vw, 5.5rem); margin-bottom: 0.15em; }
  p { margin: 0; max-width: 46ch; font-size: 1.1rem; }
  .btn { background: var(--night); border-color: var(--night); color: var(--chalk); }
  .btn:hover { background: var(--chalk); border-color: var(--chalk); color: var(--night); }
  .btn--ghost { background: transparent; color: var(--night); border-color: var(--night); }
  .btn--ghost:hover { background: var(--night); color: var(--chalk); border-color: var(--night); }
</style>
