---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CourtLines from '../components/CourtLines.astro';
import CourtDiagram from '../components/CourtDiagram.astro';
import Scoreboard from '../components/Scoreboard.astro';
import InstagramGrid from '../components/InstagramGrid.astro';
import SponsorWall from '../components/SponsorWall.astro';
import JoinBand from '../components/JoinBand.astro';
import { site } from '../data/site';
import { pathway } from '../data/teams';
import { honours } from '../data/honours';
import heroPhoto from '../assets/photos/action-3.jpg';
import champions from '../assets/photos/seniors-champions.jpg';

const majorTitles = honours.flatMap((s) => s.items.filter((i) => i.major).map((i) => ({ ...i, year: s.year })));
---

<Base>
  <section class="hero">
    <div class="hero-media">
      <Image
        src={heroPhoto}
        alt="A Lions junior in the orange home kit striking the ball on court"
        widths={[480, 768, 1024, 1365]}
        sizes="(max-width: 52rem) 100vw, 50vw"
        quality={85}
        loading="eager"
        fetchpriority="high"
      />
      <p class="credit">Photo: @captured_by_garreff</p>
    </div>
    <div class="hero-copy">
      <CourtLines class="hero-court" />
      <div class="hero-inner">
        <h1>
          <span class="line">Home of</span>
          <span class="line">the Lions</span>
        </h1>
        <p class="lede">
          {site.legalName} is a family club for boys and girls from Under 6 through to our senior side. Respect, friendships and fun, and the 2025 Futsal SA Division&nbsp;1 Champions.
        </p>
        <div class="btn-row">
          <a class="btn" href={site.registerUrl} target="_blank" rel="noopener">Join the club</a>
          <a class="btn btn--ghost" href="/contact/">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <Scoreboard />

  <InstagramGrid />

  <section class="section section--light" aria-labelledby="futsal-title">
    <div class="wrap split split--top">
      <div>
        <h2 id="futsal-title">What is futsal?</h2>
        <p class="lede">Five a side, on a hard court, with a smaller ball that barely bounces. Play never stops for long.</p>
        <p>
          That means more touches, more decisions and more creativity than any other version of the game. Players learn close control, quick thinking and how to find a way out of tight spaces, which is why so many of the world's best footballers grew up on a futsal court.
        </p>
        <p>
          Every player attacks and every player defends. Our coaches teach the positions and the rotations between them from the junior age groups up.
        </p>
      </div>
      <CourtDiagram />
    </div>
  </section>

  <section class="section" aria-labelledby="pathway-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="pathway-title">From first touch to first team</h2>
        <p class="muted">One club, one way of playing, and a clear path for every age.</p>
      </div>
      <ol class="pathway">
        {pathway.map((p) => (
          <li>
            <span class="ages">{p.ages}</span>
            <h3>{p.stage}</h3>
            <p>{p.summary}</p>
          </li>
        ))}
      </ol>
      <a class="btn btn--ghost" href="/teams/">See all teams</a>
    </div>
  </section>

  <section class="section section--court" aria-labelledby="honours-title">
    <div class="wrap split split--top split--photo">
      <figure class="honours-photo">
        <Image src={champions} alt="The senior squad celebrating with the Futsal SA Division 1 trophy" widths={[480, 768, 1080]} sizes="(max-width: 52rem) 100vw, 45vw" quality={82} />
        <figcaption>Senior Men, Futsal SA Division 1 Champions, June 2025.</figcaption>
      </figure>
      <div>
        <h2 id="honours-title">Ten years of silverware</h2>
        <ul class="titles">
          {majorTitles.map((t) => (
            <li>
              <span class="year">{t.year}</span>
              <span><strong>{t.title}</strong> {t.detail}</span>
            </li>
          ))}
        </ul>
        <a class="btn btn--ghost" href="/honours/">Full honours list</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="partners-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="partners-title">Our partners</h2>
        <p class="muted">Local businesses who keep the Lions on the court. <a href="/sponsors/">Become a sponsor</a></p>
      </div>
      <SponsorWall />
    </div>
  </section>

  <JoinBand />
</Base>

<style>
  /* Hero: copy on the left, a full-height photo bleeding off the right edge. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: min(calc(100svh - 4.5rem), 54rem);
    border-bottom: 1px solid var(--court-line);
  }
  .hero-copy {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding-block: clamp(3rem, 7vw, 5rem);
    /* line the copy up with the .wrap left edge */
    padding-left: max(var(--gutter), calc((100vw - var(--max)) / 2));
    padding-right: clamp(1.5rem, 4vw, 3.5rem);
  }
  .hero-inner { position: relative; }
  /* .hero-court lands on the CourtLines component's own SVG, so it needs :global */
  :global(.hero-court g) {
    stroke-dasharray: 2400;
    stroke-dashoffset: 2400;
    animation: draw 2.2s 0.2s cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  h1 { margin-bottom: 0.3em; }
  h1 .line { display: block; }
  h1 .line:last-child { color: var(--orange); }
  .hero .lede { color: #e6e1da; margin-bottom: 2rem; }

  .hero-media {
    position: relative;
    order: 2;
    background: var(--court);
  }
  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .hero-media::after {
    /* soft fade into the black copy panel */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--night), transparent 22%);
    pointer-events: none;
  }
  .hero-media::before {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 6px;
    background: var(--orange);
    z-index: 1;
  }
  .credit {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 1;
    margin: 0;
    padding: 0.2rem 0.5rem;
    background: rgb(0 0 0 / 0.6);
    color: #d9d3cb;
    font-size: 0.75rem;
  }

  /* Two-column sections */
  .split {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .split--top { align-items: start; }
  .split--photo { grid-template-columns: 1fr 1fr; }

  /* Heading with its intro directly underneath, both left aligned */
  .section-head { margin-bottom: 2.5rem; }
  .section-head h2 { margin-bottom: 0.3em; }
  .section-head p { margin: 0; max-width: 48ch; }

  .pathway {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .pathway li {
    position: relative;
    padding: 2.25rem 1.5rem 0 0;
    border-top: 2px solid var(--court-line);
  }
  .pathway li::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--night);
    border: 2px solid var(--orange);
  }
  .pathway li:last-child::before { background: var(--orange); }
  .pathway li:last-child { border-top-color: var(--orange); }
  .ages { color: var(--orange); font-weight: 600; font-size: 0.95rem; }
  .pathway h3 { margin: 0.35rem 0 0.6rem; font-size: var(--step-2); }
  .pathway p { color: var(--muted-dark); font-size: 0.975rem; }

  .honours-photo { margin: 0; }
  .honours-photo img { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: center 70%; }
  .honours-photo figcaption { margin-top: 0.75rem; font-size: var(--step--1); color: var(--muted-dark); }
  .titles { list-style: none; margin: 0 0 2rem; padding: 0; border-top: 1px solid var(--court-line); }
  .titles li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--court-line);
  }
  .titles .year {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.9rem;
    color: var(--ember);
    line-height: 1;
  }
  .titles strong { display: block; font-weight: 600; color: var(--chalk); }
  .titles li span:last-child { color: var(--muted-dark); }

  @media (max-width: 52rem) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .hero-media { order: 0; aspect-ratio: 4 / 5; max-height: 70svh; width: 100%; }
    .hero-media::after { background: linear-gradient(0deg, var(--night), transparent 30%); }
    .hero-media::before { display: none; }
    .credit { top: 0.75rem; bottom: auto; right: 0.75rem; }
    .hero-copy { padding: 0 var(--gutter) 3rem; margin-top: -4rem; overflow: visible; }
    :global(.hero-court) { display: none; }
    .split, .split--photo { grid-template-columns: 1fr; }
    .pathway { grid-template-columns: 1fr 1fr; row-gap: 2.5rem; }
  }
  @media (max-width: 30rem) {
    .pathway { grid-template-columns: 1fr; }
  }
</style>
